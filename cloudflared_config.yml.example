# Cloudflare Tunnel Configuration Template (VPS / Linux)
# 1. Install cloudflared: curl -L https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64.deb -o cloudflared.deb && sudo dpkg -i cloudflared.deb
# 2. Run 'cloudflared tunnel login'
# 3. Run 'cloudflared tunnel create buas-vps-tunnel'
# 4. Replace <TUNNEL_ID> and <HOSTNAME> below

tunnel: <TUNNEL_ID>
credentials-file: /root/.cloudflared/<TUNNEL_ID>.json

ingress:
  # 1. Socket.IO (Must come before /api)
  - hostname: <HOSTNAME>
    path: /socket.io
    service: http://localhost:5000

  # 2. Flask Backend (Includes /api and /api/uploads)
  - hostname: <HOSTNAME>
    path: /api
    service: http://localhost:5000

  # 3. React Frontend (served by PM2 on port 3000)
  - hostname: <HOSTNAME>
    service: http://localhost:3000

  # 4. Catch-all 404
  - service: http_status:404
