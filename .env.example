# BUAS RBAC Environment Configuration
# Copy this file to .env and update values for your environment

# Application Configuration
FLASK_APP=server.py
FLASK_ENV=production
SECRET_KEY=your-super-secret-key-here-change-this-in-production-32-chars-minimum

# Database Configuration (current implementation)
# Current backend runtime uses a fixed SQLite file at project root: uploads.db.
# DATABASE_URL is not consumed by server runtime yet.
# Keep this note here to avoid configuration drift/confusion.

# Security Configuration
# Keep False until HTTPS/TLS is live on production.
# After TLS is enabled end-to-end, switch to True.
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=3600
SESSION_COOKIE_NAME=buas_session
SESSION_COOKIE_DOMAIN=

# Device Socket.IO Authentication Rollout
# off: do not validate token
# log: log invalid/missing token but allow connection (compatibility mode)
# strict: reject invalid/missing token
DEVICE_SOCKET_TOKEN_MODE=strict

# Optional shared static token for device Socket.IO authentication.
# If empty, backend accepts BAT compatibility token format: bat-device-<android_id>
DEVICE_SOCKET_TOKEN=

# Password Policy
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=True
PASSWORD_REQUIRE_LOWERCASE=True
PASSWORD_REQUIRE_NUMBERS=True
PASSWORD_REQUIRE_SPECIAL=True
PASSWORD_HISTORY_COUNT=5
PASSWORD_MAX_AGE_DAYS=90

# Audit Logging
AUDIT_LOG_RETENTION_DAYS=2555
AUDIT_LOG_LEVEL=INFO

# File Upload Configuration
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=104857600

# Rate Limiting
RATELIMIT_STORAGE_URL=memory://
RATELIMIT_ENABLED=True
RATELIMIT_DEFAULT=100 per hour

# Email Configuration (optional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password

# Backup Configuration
BACKUP_ENABLED=True
BACKUP_SCHEDULE=daily
BACKUP_RETENTION_DAYS=30
BACKUP_LOCATION=backups/

# Monitoring
MONITORING_ENABLED=True
LOG_LEVEL=INFO
